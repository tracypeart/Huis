# Copy to .env.local for local development (or add each one to Replit Secrets).
# Never commit real values.

# Database — the app must connect as a login role that is a member of huis_app
# (NOT a superuser, NOT the table owner) so row-level security applies.
HUIS_DATABASE_URL=postgres://huis_app_login:change-me@localhost:5432/huis
# Used only by `npm run migrate` (schema owner / admin connection).
HUIS_MIGRATION_DATABASE_URL=postgres://postgres:change-me@localhost:5432/huis

# Public address of the app. Must match the redirect URI registered in Microsoft Entra:
#   <HUIS_BASE_URL>/api/auth/callback/microsoft
HUIS_BASE_URL=http://localhost:3000

# 32 random bytes, base64. Generate with: openssl rand -base64 32
HUIS_SESSION_SECRET=

# Microsoft Entra app registration "Huis Law" (development)
MICROSOFT_CLIENT_ID=834e42f3-7b16-4473-bb23-e9990b483139
# Paste from your password manager. Never commit or share in chat.
MICROSOFT_CLIENT_SECRET=

# ---- Evidence storage (Phase 2) ----
# Master key for per-firm evidence encryption (32 random bytes, base64).
# Production replaces this with a cloud key-management service.
HUIS_STORAGE_MASTER_KEY=
# Local folder for encrypted evidence during development.
# Production uses S3-compatible object storage.
HUIS_STORAGE_DIR=./.huis-storage
# Optional per-file limit in bytes (default 100 GB).
# HUIS_MAX_FILE_BYTES=

# ---- Evidence worker (run with `npm run worker`) ----
# Login role that is a member of huis_worker (can only call worker functions).
HUIS_WORKER_DATABASE_URL=postgres://huis_worker_login:change-me@localhost:5432/huis
# ClamAV daemon. Without it the worker refuses to start and files stay held.
HUIS_CLAMAV_HOST=127.0.0.1
HUIS_CLAMAV_PORT=3310

# Set to 1 only when running behind a trusted proxy/load balancer that
# appends the client IP to X-Forwarded-For (used for audit records).
# HUIS_TRUST_PROXY=1

# Text extraction needs these tools on the worker machine:
# poppler-utils (pdftotext, pdftoppm, pdfinfo), tesseract-ocr (+ eng), libreoffice (writer, calc, impress), ffmpeg, pst-utils (readpst).
